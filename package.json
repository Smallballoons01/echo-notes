{
  "name": "@dsh-plugin/echo-notes",
  "version": "0.1.0",
  "type": "module",
  "description": "Echo Notes 回声笔记 — emotion-first encrypted diary, templates, and writing reminders for DeepSeek Harness.",
  "license": "MIT",
  "author": "Smallballoons01",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smallballoons01/echo-notes.git"
  },
  "bugs": {
    "url": "https://github.com/Smallballoons01/echo-notes/issues"
  },
  "homepage": "https://github.com/Smallballoons01/echo-notes#readme",
  "keywords": ["deepseek-harness", "dsh-plugin", "diary", "journal", "mcp", "agent-tools", "encryption"],
  "engines": { "node": ">=20" },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check mcp/stdio.js",
    "mcp": "node mcp/stdio.js"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./mcp": "./mcp/stdio.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "RELEASING.md",
    "SECURITY.md",
    ".github/workflows/ci.yml",
    ".github/ISSUE_TEMPLATE/*.yml",
    "mcp/*.js",
    "mcp/README.md",
    "src/*.js",
    "skills/echo-notes/SKILL.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "zod": "4.6.5"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
